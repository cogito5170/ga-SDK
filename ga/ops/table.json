{
  "schema": "ops-table/1",
  "rules": [
    {"schema": "rule/1", "id": "o7_base_drift", "kind": "base_drift", "action": "send_back_base_drift",
     "when": {"all": [{"field": "src", "eq": "shadow"}, {"field": "descends", "eq": false}]},
     "evidence": ["id", "sha", "base_ref", "mail"]},
    {"schema": "rule/1", "id": "o4_survivors", "kind": "survivors", "action": "send_back_survivors",
     "when": {"all": [{"field": "src", "eq": "shadow"}, {"field": "survivors", "nonempty": true}]},
     "evidence": ["id", "sha", "survivors", "mail"]},
    {"schema": "rule/1", "id": "o2_backend_error", "kind": "decide_failed", "action": "retry_next_rung",
     "when": {"all": [{"field": "src", "eq": "shadow"}, {"field": "decision", "eq": "ASK_HUMAN"},
                      {"field": "error", "prefix": "backend:"}]},
     "evidence": ["id", "mail", "error", "model"]},
    {"schema": "rule/1", "id": "o2_no_call", "kind": "decide_failed", "action": "retry_next_rung",
     "when": {"all": [{"field": "src", "eq": "shadow"}, {"field": "decision", "eq": "ASK_HUMAN"},
                      {"field": "judge_class", "eq": "success"}, {"field": "tokens_in", "null": true},
                      {"field": "error", "null": true}]},
     "evidence": ["id", "mail", "judge_class", "model"]},
    {"schema": "rule/1", "id": "o2_pre_decide", "kind": "hub_pre_decide", "action": "alert_ops",
     "when": {"all": [{"field": "src", "eq": "shadow"}, {"field": "decision", "eq": "ASK_HUMAN"},
                      {"field": "judge_class", "null": true}, {"field": "tokens_in", "null": true}]},
     "evidence": ["id", "mail", "asks"]},
    {"schema": "rule/1", "id": "o5_integration_refused", "kind": "integration_refused", "action": "push_integration",
     "when": {"all": [{"field": "decision", "eq": "ASK_HUMAN"}, {"field": "judge_class", "eq": "success"},
                      {"field": "asks", "contains": "integration refused"}]},
     "evidence": ["id", "sha", "asks"]}
  ],
  "actions": [
    {"schema": "action-spec/1", "name": "retry_next_rung", "risk": "low",
     "preconditions": ["mail is in the hub's mailbox", "a ladder rung above the failed model exists"],
     "postcondition": ["shadow_row_has_model_call"], "window_s": 900, "escalate": "retry_next_rung",
     "description": "Decide the same report once more on the next ladder rung (O2)."},
    {"schema": "action-spec/1", "name": "alert_ops", "risk": "low",
     "preconditions": ["not already alerted for this kind today (UTC)"],
     "postcondition": ["alert_sent"], "window_s": 0, "escalate": null,
     "description": "Mail one notify/1 kind alert to baseline-ops (once per kind per UTC day)."},
    {"schema": "action-spec/1", "name": "send_back_base_drift", "risk": "medium",
     "preconditions": ["the directive is on file", "the report's sha does not descend from the integration branch"],
     "postcondition": ["new_report_descends"], "window_s": 21600, "escalate": "alert_ops",
     "description": "SEND_BACK 're-merge <head>' as the directive's next revision (O7)."},
    {"schema": "action-spec/1", "name": "send_back_survivors", "risk": "medium",
     "preconditions": ["the directive is on file", "the judge named surviving mutants"],
     "postcondition": ["new_report_no_survivors"], "window_s": 21600, "escalate": "alert_ops",
     "description": "SEND_BACK a templated ask per surviving mutant: file, line, expected behaviour (O4)."},
    {"schema": "action-spec/1", "name": "push_integration", "risk": "high",
     "preconditions": ["a person approved the push"], "postcondition": [], "window_s": 0, "escalate": null,
     "description": "Push the integration branch. High risk: never run by ops, alert only."},
    {"schema": "action-spec/1", "name": "wait", "risk": "low", "preconditions": [], "postcondition": [],
     "window_s": 0, "escalate": null, "description": "Do nothing now; the evidence is not an operational fault."}
  ]
}
