{
 "$description": "GA Console design tokens (W3C DTCG). The source of truth: tokens.css is generated from this file by `python -m ga.console.tokens`. Grammar: gentleMonster (paper / ink / hairline, one hot accent).",
 "color": {
  "$type": "color",
  "bg": {
   "$value": "#fbfaf7",
   "$description": "paper"
  },
  "surface": {
   "$value": "#ecece9",
   "$description": "a raised plane: input wells, code, the log"
  },
  "ink": {
   "$value": "#060c13",
   "$description": "text and rules"
  },
  "sub": {
   "$value": "#63666a",
   "$description": "captions, secondary text"
  },
  "line": {
   "$value": "#b6b7b7",
   "$description": "hairlines (decoration only, never text)"
  },
  "accent": {
   "$value": "#D9480F",
   "$description": "the one hot accent: 0.3-4 % of rendered pixels"
  },
  "accent-text": {
   "$value": "#cc440e",
   "$description": "accent as text on bg only (not on surface)"
  },
  "on-accent": {
   "$value": "#000000",
   "$description": "text on an accent fill"
  },
  "state": {
   "ok": {
    "$value": "#060c13",
    "$description": "done / healthy: ink, filled square mark"
   },
   "live": {
    "$value": "#060c13",
    "$description": "running: ink, ring mark that breathes"
   },
   "wait": {
    "$value": "#63666a",
    "$description": "waiting / unknown: sub, hollow ring mark"
   },
   "off": {
    "$value": "#b6b7b7",
    "$description": "stopped: line, a dash mark (never text)"
   },
   "fail": {
    "$value": "#D9480F",
    "$description": "failed / sent back: the accent, a cross mark; its text stays ink"
   },
   "fail-tint": {
    "$value": "#f7ece6",
    "$description": "row tint behind a failure; ink text on it"
   }
  }
 },
